# 数据库连接（默认 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./data/gupiao.db
DATA_DIR=./data

# 缓存有效期（秒）
CACHE_TTL_SPOT=14400       # 行情 4 小时
CACHE_TTL_FINANCIAL=86400  # 财报 24 小时
CACHE_TTL_DIVIDEND=86400   # 分红 24 小时

# 数据获取参数
AKSHARE_INTERVAL=3.0
AKSHARE_INTERVAL_JITTER=3.0
AKSHARE_TIMEOUT=120

# 定时刷新时间
REFRESH_HOUR=16
REFRESH_MINUTE=30
